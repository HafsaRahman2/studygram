# Frontend configuration.
#
# Vite only exposes variables prefixed VITE_ to browser code, and it inlines
# them at BUILD time - not at runtime. Changing this therefore requires a
# rebuild, which is why the deploy order matters: the backend has to exist
# before the frontend is built against it.
#
# Locally you can leave this unset; api.ts falls back to http://localhost:8080.

VITE_API_URL=https://your-backend.onrender.com
