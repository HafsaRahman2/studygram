# StudyGram backend configuration
#
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# Then load it into your shell before starting the backend:
#   set -a && source .env && set +a
#   ./mvnw spring-boot:run
#
# .env is gitignored. Never commit real keys.

# --- Database -------------------------------------------------------------
# On macOS with Homebrew Postgres, the role is usually your Mac username.
DB_URL=jdbc:postgresql://localhost:5432/studygram
DB_USERNAME=postgres
DB_PASSWORD=

# --- Groq AI --------------------------------------------------------------
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Frontend origins allowed to call this API ----------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
